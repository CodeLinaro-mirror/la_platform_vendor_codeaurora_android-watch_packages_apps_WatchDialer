<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:padding="@dimen/text_size_16"
        android:orientation="vertical">

        <!-- Details Section with Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/size_16"
            android:background="@drawable/rounded_background"
            android:orientation="vertical"
            android:paddingVertical="@dimen/size_16">

            <!-- Name and Number with Add to Contact and Call Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Add to Contact Icon -->
                <ImageButton
                    android:id="@+id/add_view_contact_icon"
                    android:layout_width="@dimen/size_56"
                    android:layout_height="@dimen/size_56"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/watch_add_to_contacts"
                    android:src="@drawable/quantum_ic_person_add_white_24"
                    app:tint="@android:color/black" />

                <!-- Name and Number Container -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <!-- Name -->
                    <TextView
                        android:id="@+id/call_details_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="@dimen/size_4"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_size_18"
                        android:visibility="gone" />

                    <!-- Number -->
                    <TextView
                        android:id="@+id/call_details_number"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="@dimen/size_8"
                        android:singleLine="true"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/text_size_18" />
                </LinearLayout>

                <!-- Copy Icon -->
                <ImageButton
                    android:id="@+id/copy_number_icon"
                    android:layout_width="@dimen/size_56"
                    android:layout_height="@dimen/size_56"
                    android:background="?attr/selectableItemBackground"
                    android:contentDescription="@string/watch_copy_number"
                    android:src="@drawable/quantum_ic_content_copy_grey600_24"
                    app:tint="@android:color/black" />
            </LinearLayout>

            <!-- Call Type, Duration, and Date -->
            <LinearLayout
                android:id="@+id/call_details_type_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="@dimen/size_8"
                android:paddingBottom="@dimen/size_8">

                <ImageView
                    android:id="@+id/call_details_type_icon"
                    android:layout_width="@dimen/size_24"
                    android:layout_height="@dimen/size_24"
                    android:layout_marginEnd="@dimen/size_8"
                    android:contentDescription="@string/watch_call_type_icon" />

                <TextView
                    android:id="@+id/call_details_type"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_size_16" />

                <TextView
                    android:id="@+id/call_details_duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/text_size_16" />
            </LinearLayout>

            <!-- Date -->
            <TextView
                android:id="@+id/call_details_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/size_8"
                android:paddingBottom="@dimen/size_8"
                android:textColor="@android:color/black"
                android:textSize="@dimen/text_size_16" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/size_8">

            <ImageButton
                android:id="@+id/message_button"
                android:layout_width="@dimen/size_60"
                android:layout_height="@dimen/size_60"
                android:layout_marginEnd="@dimen/size_12"
                android:background="@drawable/rounded_background_action_ripple"
                android:contentDescription="@string/watch_message"
                android:src="@drawable/quantum_ic_message_white_24"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/call_button"
                android:layout_width="@dimen/size_60"
                android:layout_height="@dimen/size_60"
                android:layout_marginStart="@dimen/size_8"
                android:layout_marginEnd="@dimen/size_12"
                android:background="@drawable/rounded_background_action_ripple"
                android:contentDescription="@string/watch_call"
                android:src="@drawable/quantum_ic_call_white_24"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/block_number"
                android:layout_width="@dimen/size_60"
                android:layout_height="@dimen/size_60"
                android:layout_marginEnd="@dimen/size_12"
                android:background="@drawable/rounded_background_action_ripple"
                android:backgroundTint="@android:color/darker_gray"
                android:contentDescription="@string/watch_block_number"
                android:enabled="false"
                android:src="@drawable/quantum_ic_block_white_24"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/delete_number"
                android:layout_width="@dimen/size_60"
                android:layout_height="@dimen/size_60"
                android:layout_marginEnd="@dimen/size_12"
                android:background="@drawable/rounded_background_action_ripple"
                android:contentDescription="@string/watch_delete_number"
                android:src="@drawable/quantum_ic_delete_vd_theme_24"
                android:visibility="gone"
                app:tint="@android:color/white" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
